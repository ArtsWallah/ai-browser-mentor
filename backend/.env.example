# ============================================================
# AI Browser Mentor - Environment Configuration
# ============================================================

# Environment: development | production
ENVIRONMENT=development

# Groq API Configuration
# Get your API key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Security & CORS Configuration
# Comma-separated list of allowed origins. Leave blank in dev to default to localhost.
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Explicitly allowed 32-character lowercase Chrome extension ID(s)
# EXTENSION_ID=abcdefghijklmnopqrstuvwxyzabcdef
# ALLOWED_EXTENSION_IDS=abcdefghijklmnopqrstuvwxyzabcdef,bcdefghijklmnopqrstuvwxyzabcde
# Allow localhost web origins (http://localhost:*, http://127.0.0.1:*).
# Defaults to true in development/testing, but defaults to false in production.
# In production, set to true only if explicitly debugging against a remote backend.
ALLOW_LOCALHOST=true
# Unrestricted extension regex matching is disabled by default for security.
# In production, it is strictly forbidden regardless of this setting.
ALLOW_EXTENSION_REGEX=false

# Rate Limiting & Abuse Prevention
AI_RATE_LIMIT=30/minute
RATE_LIMIT_STORAGE_URL=memory://
MAX_REQUEST_BODY_SIZE=2097152
MAX_IN_MEMORY_PAGES=100

# Debug Endpoint Authorization (Required to enable /debug/pages and /debug/pages/{page_id})
# Debug endpoints remain safely disabled in all environments (development, testing, staging, production)
# when this variable is empty or missing. A valid token is required for all debug requests.
DEBUG_ACCESS_TOKEN=your_secure_debug_token_here

# Discovery Endpoint Authorization (Required for POST /scamshield/discovery/run and /review)
# If unset or empty, discovery execution and review mutation endpoints are safely disabled.
DISCOVERY_ACCESS_TOKEN=your_secure_discovery_token_here

# ScamShield Security ML Model (relative path or mounted volume)
# If not provided or unavailable, backend gracefully falls back to heuristic checks
SCAMSHIELD_MODEL_PATH=./data/models/tfidf_multilabel_baseline.joblib
SCAMSHIELD_SPAM_MODEL_PATH=./data/models/baseline_tfidf_logistic.pkl

# Server Options
HOST=127.0.0.1
PORT=8000

# Memory Diagnostics (Render / Linux container profiling)
# Enables lightweight checkpoints for process RSS, peak RSS, and system available memory
# Disabled by default. Set to true in Render environment settings to diagnose memory usage without paid metrics.
ENABLE_MEMORY_DIAGNOSTICS=false
