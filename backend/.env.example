# ============================================================
# AI Browser Mentor - Environment Configuration
# ============================================================

# Groq API Configuration
# Get your API key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# ScamShield Security ML Model
# Path to the trained multilabel tactic classification model
# If not provided or unavailable, the backend gracefully falls back to heuristic security checks
SCAMSHIELD_MODEL_PATH=C:/path/to/models/tfidf_multilabel_baseline.joblib

# Server Options
HOST=127.0.0.1
PORT=8000
