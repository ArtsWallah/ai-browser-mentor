{
  "manifest_version": 3,

  "name": "AI Browser Mentor",

  "version": "0.1.0",

  "description": "An AI-powered browser assistant that understands the webpages you visit.",

  "permissions": [
    "storage",
    "scripting",
    "activeTab"
  ],

  "host_permissions": [
    "https://ai-browser-mentor.onrender.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],

  "optional_host_permissions": [
    "https://*/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": { "default_title": "AI Browser Mentor", "default_popup": "popup.html" },

  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "config.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
